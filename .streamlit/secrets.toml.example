# Copie este arquivo para .streamlit/secrets.toml e preencha com suas credenciais do Turso.
# Sem esse arquivo (ou sem essas chaves), o sistema usa automaticamente o SQLite local.
#
# Como obter esses valores: veja o passo a passo na seção "Banco em nuvem (Turso)" do README.md

TURSO_DATABASE_URL = "libsql://seu-banco-sua-org.turso.io"
TURSO_AUTH_TOKEN = "seu-token-aqui"
